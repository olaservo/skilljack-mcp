{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["src/**/*"],
  // src/ui/** is the browser half. It needs the DOM lib and no Node types, and
  // Vite bundles it separately into self-contained HTML, so it is excluded here
  // and typechecked by tsconfig.ui.json instead (run by `npm run build:ui`).
  // The two halves only ever meet over the MCP wire.
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/__fixtures__/**",
    "src/__test-helpers__/**",
    "src/ui/**"
  ]
}
